# ---------------------------------------------------------------
# PLANTILLA de variables de entorno (valores FICTICIOS).
# Uso: copia este archivo como ".env" y rellena los valores reales:
#   cp .env.example .env
# El archivo .env NO se sube a git (esta en .gitignore).
# En produccion estas variables se configuran en Vercel (y en la Fase 6, en EC2).
# ---------------------------------------------------------------

# --- IA (Groq, compatible con el SDK de OpenAI) -----------------
# SECRETA. Solo la usa el backend en tiempo de ejecucion; nunca llega al navegador.
# Se obtiene en https://console.groq.com (empieza por gsk_).
OPENAI_API_KEY=gsk_tu-clave-aqui

# Configuracion (no secreta). Direccion de la API de Groq.
# Si se borra, el SDK usaria la API de OpenAI directamente.
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Configuracion (no secreta). Modelo de Groq que se usa para traducir.
# Lista actual de modelos: GET https://api.groq.com/openai/v1/models
AI_MODEL=openai/gpt-oss-120b

# --- Clerk (autenticacion) --------------------------------------
# Se anadiran en la Fase 4.
