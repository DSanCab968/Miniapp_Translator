# ---------------------------------------------------------------
# PLANTILLA de variables de entorno (valores FICTICIOS).
# Uso: copia este archivo como ".env" y rellena los valores reales:
#   cp .env.example .env
# El archivo .env NO se sube a git (esta en .gitignore).
# En produccion estas variables se configuran en Vercel (y en la Fase 6, en EC2).
# ---------------------------------------------------------------

# --- IA (Groq, compatible con el SDK de OpenAI) -----------------
# SECRETA. Solo la usa el backend en tiempo de ejecucion; nunca llega al navegador.
# Se obtiene en https://console.groq.com (empieza por gsk_).
OPENAI_API_KEY=gsk_tu-clave-aqui

# Configuracion (no secreta). Direccion de la API de Groq.
# Si se borra, el SDK usaria la API de OpenAI directamente.
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Configuracion (no secreta). Modelo de Groq que se usa para traducir.
# Lista actual de modelos: GET https://api.groq.com/openai/v1/models
AI_MODEL=openai/gpt-oss-120b

# --- Clerk (autenticacion) --------------------------------------
# Se obtienen en https://dashboard.clerk.com -> tu aplicacion -> API keys.

# PUBLICA: va dentro del JavaScript que descarga el navegador (por eso empieza por VITE_).
# Se lee al COMPILAR el frontend: si cambia, hay que recompilar / redesplegar.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_tu-clave-publica-aqui

# SECRETA. Solo la usa el backend (en ejecucion) para validar los tokens de sesion.
CLERK_SECRET_KEY=sk_test_tu-clave-secreta-aqui

# Configuracion (no secreta). Origenes (webs) autorizados a usar la API, separados por comas.
# El token de Clerk lleva el origen que lo pidio (claim "azp"); si no esta en esta lista -> 401.
# En local: la web de Vite. En Vercel: la URL de produccion.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
